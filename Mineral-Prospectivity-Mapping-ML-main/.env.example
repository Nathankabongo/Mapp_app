# CriticalMineralsCompass — variables d'environnement

# JWT (désactivé par défaut en local)
COMPASS_JWT_ENABLED=false
COMPASS_JWT_SECRET=change-me-in-production-use-long-random-string
COMPASS_JWT_EXPIRE_MINUTES=480

# Identifiants API (mode démo)
COMPASS_API_USER=admin
COMPASS_API_PASSWORD=compass-rdc

# Streamlit → API
COMPASS_API_URL=http://127.0.0.1:8000
